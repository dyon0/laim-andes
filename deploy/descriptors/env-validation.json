                                    "type": "string",
                                    "defaultValue": "30",
                                    "placeholder": "целое > 0",
                                    "uiComponent": "input"
                                },
                                {
                                    "parameter": "volume_target",
                                    "label": "volume_target — центр логистики объёма (эфф. трасс)",
                                    "type": "string",
                                    "defaultValue": "100000",
                                    "placeholder": "напр. 100000",
                                    "uiComponent": "input"
                                },
                                {
                                    "parameter": "volume_steepness",
                                    "label": "volume_steepness — крутизна логистики объёма",
                                    "type": "string",
                                    "defaultValue": "1.5",
                                    "placeholder": "напр. 1.5",
                                    "uiComponent": "input"
                                },
                                {
                                    "parameter": "rate_target",
                                    "label": "rate_target — целевой приток трасс/корзину",
                                    "type": "string",
                                    "defaultValue": "1000",
                                    "placeholder": "напр. 1000",
                                    "uiComponent": "input"
                                },
                                {
                                    "parameter": "min_eff_traces",
                                    "label": "min_eff_traces — гейт: минимум эффективных трасс",
                                    "type": "string",
                                    "defaultValue": "10000",
                                    "placeholder": "напр. 10000",
                                    "uiComponent": "input"
                                },
                                {
                                    "parameter": "max_loss",
                                    "label": "max_loss — гейт: макс. доля отбраковки",
                                    "type": "string",
                                    "defaultValue": "0.30",
                                    "placeholder": "0..1",
                                    "uiComponent": "input"
                                },
                                {
                                    "parameter": "min_quality",
                                    "label": "min_quality — гейт: минимум качества",
                                    "type": "string",
                                    "defaultValue": "0.80",
                                    "placeholder": "0..1",
                                    "uiComponent": "input"
                                },
                                {
                                    "parameter": "ready_at",
                                    "label": "ready_at — порог готовности (ready)",
                                    "type": "string",
                                    "defaultValue": "0.70",
                                    "placeholder": "0..1",
                                    "uiComponent": "input"
                                },
                                {
                                    "parameter": "pilot_at",
                                    "label": "pilot_at — порог пилота (pilot)",
