                                        },
                                        {
                                            "gpu": "gpu"
                                        }
                                    ]
                                },
                                {
                                    "parameter": "significance",
                                    "label": "significance — пресет значимости (A строжайший … E мягкий), задаёт центры/гейты политики",
                                    "defaultValue": "C",
                                    "uiComponent": "select",
                                    "placeholder": "Select value",
                                    "allowedValues": [
                                        {
                                            "A": "A"
                                        },
