                                    "defaultValue": "0.50",
                                    "placeholder": "0..1",
                                    "uiComponent": "input"
                                },
                                {
                                    "parameter": "recast",
                                    "label": "recast — выравнивание типов через строки (если в parquet кривые типы)",
