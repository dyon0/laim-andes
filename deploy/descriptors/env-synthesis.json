                "title": "Параметры генерации",
                "components": [
                    {
                        "type": "text",
                        "label": "Как заполнять параметры",
                        "config": {
                            "datasets": [
                                {
                                    "value": "Генерация синтетических трейс-спанов (ТЗ 1.9.2). Один рычаг объёма — target_spans. Форматы полей:\n• target_spans — желаемое число записей-спанов (целое > 0). Модуль распределит его по агентам (в пропорции базовых долей) и сценариям; фактический объём «+- близко».\n• out_path — путь записи parquet (смонтированный/общий том).\n• seed — целое зерно ГПСЧ.\n• window_days — окно по времени, дней.\n• traces_per_session — трасс на сессию.\n• id_length — длина base64-идентификаторов.\n• corrupt_rate — базовая доля порчи (0..1).\n• error_rate — доля STATUS_CODE_ERROR (0..1).\n• unset_rate — доля STATUS_CODE_UNSET (0..1)."
                                }
                            ]
                        }
                    },
                    {
                        "type": "form",
                        "label": "настройки генератора синтетики",
                        "config": {
                            "components": [
                                {
                                    "parameter": "target_spans",
                                    "label": "target_spans — желаемое число спанов (единый рычаг объёма)",
                                    "type": "string",
                                    "defaultValue": "100000",
                                    "placeholder": "целое > 0, напр. 100000",
                                    "uiComponent": "input"
                                },
                                {
                                    "parameter": "out_path",
                                    "label": "out_path — путь записи parquet",
                                    "type": "string",
                                    "defaultValue": "/mnt/data/traces/raw/parquet/spans_example.parquet",
                                    "placeholder": "/mnt/data/.../spans.parquet",
                                    "uiComponent": "input"
                                },
                                {
                                    "parameter": "seed",
                                    "label": "seed — зерно ГПСЧ",
                                    "type": "string",
                                    "defaultValue": "20250601",
                                    "placeholder": "целое",
                                    "uiComponent": "input"
                                },
                                {
                                    "parameter": "window_days",
                                    "label": "window_days — окно по времени, дней",
                                    "type": "string",
                                    "defaultValue": "40",
                                    "placeholder": "целое > 0",
                                    "uiComponent": "input"
                                },
                                {
                                    "parameter": "traces_per_session",
                                    "label": "traces_per_session — трасс на сессию",
                                    "type": "string",
                                    "defaultValue": "3",
                                    "placeholder": "целое > 0",
                                    "uiComponent": "input"
                                },
                                {
                                    "parameter": "id_length",
                                    "label": "id_length — длина base64-идентификаторов",
                                    "type": "string",
                                    "defaultValue": "10",
                                    "placeholder": "целое > 0",
                                    "uiComponent": "input"
                                },
                                {
                                    "parameter": "corrupt_rate",
                                    "label": "corrupt_rate — базовая доля порчи",
                                    "type": "string",
                                    "defaultValue": "0.25",
                                    "placeholder": "0..1",
                                    "uiComponent": "input"
                                },
                                {
                                    "parameter": "error_rate",
                                    "label": "error_rate — доля ошибок (STATUS_CODE_ERROR)",
                                    "type": "string",
                                    "defaultValue": "0.10",
                                    "placeholder": "0..1",
                                    "uiComponent": "input"
                                },
                                {
                                    "parameter": "unset_rate",
                                    "label": "unset_rate — доля STATUS_CODE_UNSET",
                                    "type": "string",
                                    "defaultValue": "0.05",
                                    "placeholder": "0..1",
                                    "uiComponent": "input"
                                },
                                {
