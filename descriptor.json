{
    "id": "30da3739-2287-4551-a932-eb9846b56c7e",
    "name": "laim | anomaly detector (train / inference)",
    "description": "Детектор аномалий МАС (LumiMAS): train — обучение на спанах AEF, inference — скоринг обученным бандлом (p_anomaly, тип аномалии, RCA).",
    "fullDescription": "Одна нода, два режима (параметр mode). TRAIN: спаны → признаки → инъекция → LSTM-AE/FMLP-AE → порог/калибровка → zip-бандл модели (model_out). INFERENCE: бандл (model_in или model_path) + спаны → anomaly_traces / test_anomalies. Отпечаток эмбеддера проверяется при загрузке бандла.",
    "shortNameToDisplay": "laim-detector",
    "ports": [
        {
            "in": true,
            "name": "path_traces_train",
            "label": "path_traces_train",
            "description": "Спаны AEF для обучения (режим train). Тип dataframe, без getPortAsLocalPath.",
            "type": "dataframe",
            "shape": "shape_dataframe",
            "required": false,
            "order": 1
        },
        {
            "in": true,
            "name": "path_traces_infer",
            "label": "path_traces_infer",
            "description": "Спаны AEF для скоринга (режим inference; в train опционален). Тип dataframe, без getPortAsLocalPath.",
            "type": "dataframe",
            "shape": "shape_dataframe",
            "required": false,
            "order": 2
        },
        {
            "in": true,
            "name": "path_embedder",
            "label": "path_embedder",
            "description": "Модель эмбеддера USER-bge-m3 (каталог или zip/tar). Обязателен в обоих режимах.",
            "type": "default",
            "shape": "shape_model",
            "required": true,
            "order": 3,
            "getPortAsLocalPath": true
        },
        {
            "in": true,
            "name": "model_in",
            "label": "model_in",
            "description": "Бандл модели из режима train (zip). Альтернатива — параметр model_path.",
            "type": "default",
            "shape": "shape_model",
            "required": false,
            "order": 4,
            "getPortAsLocalPath": true
        },
        {
            "in": false,
            "name": "model_out",
            "label": "model_out",
            "description": "Бандл обученной модели: zip в base64 внутри JSON (+sha256). Соединяется с model_in.",
            "type": "default",
            "shape": "shape_model",
            "order": 5
        },
        {
            "in": false,
            "name": "detector_metrics_holdout",
            "label": "detector_metrics_holdout",
            "description": "Метрики детектора на hold-out (train); пусто в inference.",
            "type": "default",
            "shape": "shape_model",
            "order": 6
        },
        {
            "in": false,
            "name": "classifier_metrics_holdout",
            "label": "classifier_metrics_holdout",
            "description": "Метрики классификатора типов аномалий (если обучен).",
            "type": "default",
            "shape": "shape_model",
            "order": 7
        },
        {
            "in": false,
            "name": "eval_report",
            "label": "eval_report",
            "description": "Отчёт оценки (train) / сводка скоринга (inference).",
            "type": "default",
            "order": 8
        },
        {
            "in": false,
            "name": "anomaly_traces",
            "label": "anomaly_traces",
            "description": "Датафрейм аномальных трасс: p_anomaly, confidence, тип, RCA.",
            "type": "dataframe",
            "shape": "shape_dataframe",
            "order": 9
        },
        {
            "in": false,
            "name": "test_anomalies",
            "label": "test_anomalies",
            "description": "JSON {\"anomalies\": [...]} — контракт продукта.",
            "type": "default",
            "order": 10
        },
        {
            "in": false,
            "name": "html_reports",
            "label": "html_reports",
            "description": "HTML-отчёты этапов обучения.",
            "type": "default",
            "shape": "shape_model",
            "order": 11
        },
        {
            "in": false,
            "name": "manifest",
            "label": "manifest",
            "description": "Манифест запуска: хэши входов, сиды, тайминги, метрики.",
            "type": "default",
            "order": 12
        }
    ],
    "script": {
        "type": "python",
        "baseImageKey": "py312-gpu",
        "deployType": "docker",
        "runConfiguration": {
            "sourceFiles": [
                "run.py"
            ],
            "functionName": "main",
            "functionParameters": [],
            "output": {
                "type": "json",
                "output": []
